    "description": "Canonical municipality identities and codes used by the regional analysis."
  },
  "year_semantics": {
    "source_year_reference_offset": 1,
    "description": "The SCB register year y uses the municipality division effective on 1 January y+1, so source_year_reference_offset is added before testing official validity and formation years. Alias validity uses official calendar years. Canonical municipality identities are inactive before their official formation year. Historical aliases may map to a canonical code before that code itself was introduced because the canonical code is an analysis identifier, not a claim about the historical code in force.",
    "new_municipality_policy": "Do not backfill a municipality identity before its official formation year.",
    "merge_policy": "Where multiple historical source areas have one canonical successor, map all predecessors to that successor for the full study period in which they occur."
  },
  "invalid_source_codes": [
    "0000",
    "9999"
  ],
